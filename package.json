{
  "name": "mef-calendar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env.local scripts/seed-semesters.mts",
    "db:import-catalog": "tsx --env-file=.env.local scripts/import-catalog.mts",
    "ocr:debug": "tsx scripts/ocr-debug.mts",
    "ingest:smoke": "tsx --env-file=.env.local scripts/ingest-smoke.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
